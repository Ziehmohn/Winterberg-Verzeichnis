# APP_URL: The public base URL of the site
APP_URL="https://www.winterberg-verzeichnis.de"

# ADMIN_PASSWORD: Password to access the admin backend
ADMIN_PASSWORD="admin"

# STRIPE CONFIGURATION
# Secret Key from Stripe Dashboard (API Keys): starts with sk_test_... or sk_live_...
STRIPE_SECRET_KEY="sk_test_..."
# Webhook Signing Secret from Stripe Dashboard (Webhooks -> Endpoint): starts with whsec_...
STRIPE_WEBHOOK_SECRET="whsec_..."

# FIREBASE SERVICE ACCOUNT (JSON string for Firebase Admin SDK in serverless functions)
# Example: '{"type":"service_account","project_id":"...","private_key":"...","client_email":"..."}'
FIREBASE_SERVICE_ACCOUNT=""

# EMAIL / SMTP CONFIGURATION (For notifications on new submissions & payments)
SMTP_HOST="smtp.example.com"
SMTP_PORT="465"
SMTP_USER="info@sichtbar-online.com"
SMTP_PASS="your_smtp_password"

