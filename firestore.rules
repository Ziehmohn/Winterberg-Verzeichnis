rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {

    // ---------------------------------------------------------------
    // Helpers
    // ---------------------------------------------------------------
    function isSignedIn() {
      return request.auth != null;
    }

    // The ONLY admin account.
    function isAdmin() {
      return request.auth != null
        && request.auth.token.email is string
        && request.auth.token.email.lower() == 'simon.kraeling@sichtbar-online.com';
    }

    function isOptionalString(data, key, maxLen) {
      return !(key in data) || data[key] == null
        || (data[key] is string && data[key].size() <= maxLen);
    }

    // ---------------------------------------------------------------
    // Users
    // ---------------------------------------------------------------
    // Fields a user may write on their own profile document.
    function userSelfFieldsValid(data) {
      return isOptionalString(data, 'displayName', 200)
        && isOptionalString(data, 'phone', 50)
        && isOptionalString(data, 'email', 320)
        && isOptionalString(data, 'createdAt', 40)
        && isOptionalString(data, 'lastLoginAt', 40);
    }

    function isValidSelfCreate(userId) {
      let d = request.resource.data;
      return d.keys().hasOnly(['uid', 'email', 'displayName', 'phone', 'createdAt', 'lastLoginAt', 'role'])
        && d.uid == userId
        && d.email == request.auth.token.email
        && (!('role' in d) || d.role == 'user')
        && userSelfFieldsValid(d);
    }

    function isValidSelfUpdate() {
      let d = request.resource.data;
      let changed = d.diff(resource.data).affectedKeys();
      return changed.hasOnly(['displayName', 'phone', 'lastLoginAt', 'email'])
        && (!changed.hasAny(['email']) || d.email == request.auth.token.email)
        && userSelfFieldsValid(d);
    }

    match /users/{userId} {
      allow read: if isSignedIn() && (request.auth.uid == userId || isAdmin());
      allow create: if isAdmin()
        || (isSignedIn() && request.auth.uid == userId && isValidSelfCreate(userId));
      allow update: if isAdmin()
        || (isSignedIn() && request.auth.uid == userId && isValidSelfUpdate());
      allow delete: if isAdmin();
    }

    // ---------------------------------------------------------------
    // Messages (admin -> user in-app messages)
    // ---------------------------------------------------------------
    match /messages/{messageId} {
      allow read: if isAdmin()
        || (isSignedIn() && resource.data.toUid == request.auth.uid);
      allow create, delete: if isAdmin();
      allow update: if isAdmin()
        || (isSignedIn()
            && resource.data.toUid == request.auth.uid
            && request.resource.data.diff(resource.data).affectedKeys().hasOnly(['read', 'readAt'])
            && (!('read' in request.resource.data) || request.resource.data.read is bool)
            && (!('readAt' in request.resource.data) || request.resource.data.readAt == null
                || request.resource.data.readAt is string));
    }

    // ---------------------------------------------------------------
    // Businesses
    // ---------------------------------------------------------------
    function isBusinessOwner() {
      return isSignedIn() && (
        request.auth.uid == resource.data.ownerId
        || (request.auth.token.email != null && request.auth.token.email == resource.data.ownerEmail)
      );
    }

    function ownerUpdateAllowed() {
      return !request.resource.data.diff(resource.data).affectedKeys().hasAny([
        'isPremium', 'ownerId', 'ownerEmail', 'status', 'isActive',
        'deactivationRedirectType', 'deactivationRedirectUrl', 'isVerified',
        'premiumUntil', 'stripeCustomerId', 'stripeSubscriptionId'
      ]);
    }

    match /businesses/{businessId} {
      allow read: if true;
      allow create: if isAdmin();
      allow update: if isAdmin()
        || (isBusinessOwner() && ownerUpdateAllowed())
        || request.resource.data.diff(resource.data).affectedKeys().hasOnly(['reviews']);
      allow delete: if isAdmin();
    }

    // ---------------------------------------------------------------
    // Other collections (unchanged behaviour)
    // ---------------------------------------------------------------
    match /news/{newsId} {
      allow read: if true;
      allow write: if true;
    }

    match /redirects/{docId} {
      allow read: if true;
      allow write: if isAdmin();
    }

    match /settings/{settingId} {
      allow read: if true;
      allow write: if isAdmin();
    }

    match /ads/{adId} {
      allow read: if true;
      allow create, delete: if isAdmin();
      allow update: if isAdmin() || (request.auth != null && request.resource.data.diff(resource.data).affectedKeys().hasOnly(['clicks']));
    }

    match /ad_inquiries/{inquiryId} {
      allow read: if isAdmin();
      allow create: if true;
      allow update, delete: if isAdmin();
    }

    match /invoices/{invoiceId} {
      allow read: if isAdmin() || (request.auth != null && (resource.data.customerEmail == request.auth.token.email || resource.data.customerId == request.auth.uid));
      allow write: if isAdmin();
    }

    match /claims/{claimId} {
      allow create: if true;
      allow read: if isAdmin()
        || (isSignedIn() && resource.data.userId == request.auth.uid);
      allow update, delete: if isAdmin();
    }

    match /mail/{mailId} {
      allow create: if true;
      allow read, update, delete: if isAdmin();
    }

    match /questions/{questionId} {
      allow read: if true;
      allow create: if true;
      allow update: if true;
      allow delete: if isAdmin();
    }

    match /system/{docId} {
      allow read: if true;
      allow write: if isAdmin();
    }
  }
}
